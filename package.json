{
  "name": "kabirian-college",
  "version": "0.1.0",
  "private": true,
  "description": "Kabirian College Management System — Admin, Staff and Student portals (PWA)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "seed:reference": "tsx prisma/seed/reference.ts",
    "seed:structure": "tsx prisma/seed/structure.ts",
    "seed:dev": "tsx prisma/seed/dev.ts",
    "setup": "npm run db:migrate && npm run seed:reference && npm run seed:structure && npm run create-admin",
    "create-admin": "tsx scripts/create-admin.ts",
    "check:db": "tsx scripts/check-db.ts",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@googleapis/drive": "^21.0.0",
    "@node-rs/argon2": "2.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "^10.5.0",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true
  }
}
