# =============================================================================
# Kabirian College Management System — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the app. In development this is http://localhost:3000
APP_URL="http://localhost:3000"

# The college's time zone. All "today" logic (attendance dates, etc.) uses it.
APP_TIMEZONE="Asia/Karachi"

# Display name used in the UI, page titles and the PWA manifest.
APP_COLLEGE_NAME="Kabirian College"

# How long a login session stays valid without activity (days).
SESSION_MAX_AGE_DAYS="30"

# debug | info | warn | error
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Free options for development and small production use:
#   * Neon      https://neon.com          (free tier, nothing to install)
#   * Supabase  https://supabase.com      (free tier, Postgres only is fine)
#   * Local     https://postgresql.org    (free, installed on your own machine)
#
# Neon example — use sslmode=verify-full so the server certificate is actually
# checked (sslmode=require alone does not verify it):
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=verify-full&channel_binding=require
# Local example:
#   postgresql://postgres:yourpassword@localhost:5432/kabirian_college
DATABASE_URL=

# Optional. The *unpooled* database connection, used only by `prisma migrate`.
#
# Connection poolers (Neon's -pooler host, Supabase's port 6543, PgBouncer) drop
# long DDL scripts partway through, which leaves a migration half-applied. Point
# this at the direct endpoint and migrations run safely; the application itself
# keeps using DATABASE_URL. On Neon the direct host is the pooled one with
# "-pooler" removed:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=verify-full
# Leave blank when your DATABASE_URL is already a direct connection.
DATABASE_DIRECT_URL=

# How many database connections the server keeps open at once.
# Free hosted tiers allow only a few — raise this only on a bigger plan.
DATABASE_POOL_MAX="10"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 32 random bytes, base64. Used to encrypt secrets we store in the database
# (for example the Google Drive refresh token in Phase 6).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Drive  (Phase 6)
# -----------------------------------------------------------------------------
# Storage backend: "none" refuses every upload with a clear message;
# "google_drive" enables document storage. See README, "Connecting Google Drive".
STORAGE_PROVIDER=none

# oauth | service_account   — see DECISIONS.md ADR-010
GOOGLE_STORAGE_MODE="oauth"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/settings/google/callback"
# Only for service_account mode (base64 of the downloaded JSON key file)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Filled in by the Phase 6 setup script
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# -----------------------------------------------------------------------------
# Uploads (Phase 6)
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB="10"
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,application/pdf"
# trash | keep — what happens to the old file when a document is replaced
DOCUMENT_REPLACE_POLICY="trash"
